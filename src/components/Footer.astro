---
const services = [
  'Guest Communication',
  'Hospitality Management',
  'Logistics & Transport',
  'Airport Operations',
  'On-Ground Operations',
  'Destination Management',
];

const company = [
  { label: 'About', href: '/about' },
  { label: 'Services', href: '/services' },
  { label: 'How It Works', href: '/how-it-works' },
  { label: 'Case Studies', href: '/case-studies' },
  { label: 'Contact', href: '/contact' },
];
---

<footer class="bg-surface-950 border-t border-surface-900">

  <!-- Top CTA band -->
  <div class="bg-brand-gradient-subtle border-b border-brand-700/20">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 py-10 flex flex-col md:flex-row items-center justify-between gap-6">
      <div>
        <p class="label-text mb-2">Ready to Begin?</p>
        <h3 class="font-display text-2xl lg:text-3xl text-white font-medium">Let's build the system behind your event.</h3>
      </div>
      <a
        href="/contact"
        class="flex-shrink-0 inline-flex items-center gap-2 px-7 py-3.5 bg-brand-gradient rounded-lg text-white font-sans font-semibold text-sm shadow-lg shadow-brand-700/30 hover:shadow-brand-500/40 hover:scale-105 transition-all duration-300"
      >
        Start Planning
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
          <path d="M1 7h12M8 3l5 4-5 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
  </div>

  <!-- Main footer content -->
  <div class="max-w-7xl mx-auto px-6 lg:px-8 py-16 lg:py-20">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-8">

      <!-- Brand column -->
      <div class="lg:col-span-1">
        <a href="/" class="flex items-center gap-3 mb-5">
          <img src="/logo-mark.svg" alt="" class="h-9 w-auto flex-shrink-0" />
          <span class="font-display text-lg font-semibold text-white">EventConnect<span class="text-gradient">+</span></span>
        </a>
        <p class="font-sans text-sm text-surface-600 leading-relaxed mb-6">
          Guest Experience, Engineered. We design and manage the complete guest journey for destination weddings, corporate events, and large-scale gatherings.
        </p>
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-gold-500/30 bg-gold-500/5">
          <div class="w-1.5 h-1.5 rounded-full bg-gold-500"></div>
          <span class="text-gold-500 text-xs font-sans font-medium tracking-wide">India's No. 1 Guest Experience Company</span>
        </div>
      </div>

      <!-- Services -->
      <div>
        <h4 class="font-sans text-xs font-semibold uppercase tracking-[0.18em] text-surface-600 mb-5">Services</h4>
        <ul class="space-y-3">
          {services.map((service) => (
            <li>
              <a
                href="/services"
                class="font-sans text-sm text-surface-500 hover:text-white transition-colors duration-200"
              >
                {service}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Company -->
      <div>
        <h4 class="font-sans text-xs font-semibold uppercase tracking-[0.18em] text-surface-600 mb-5">Company</h4>
        <ul class="space-y-3">
          {company.map((link) => (
            <li>
              <a
                href={link.href}
                class="font-sans text-sm text-surface-500 hover:text-white transition-colors duration-200"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h4 class="font-sans text-xs font-semibold uppercase tracking-[0.18em] text-surface-600 mb-5">Get In Touch</h4>
        <div class="space-y-4">
          <div>
            <p class="font-sans text-xs text-surface-600 uppercase tracking-wider mb-1">Email</p>
            <a href="mailto:hello@eventconnectplus.com" class="font-sans text-sm text-surface-400 hover:text-white transition-colors">
              hello@eventconnectplus.com
            </a>
          </div>
          <div>
            <p class="font-sans text-xs text-surface-600 uppercase tracking-wider mb-1">Phone</p>
            <a href="tel:+919999999999" class="font-sans text-sm text-surface-400 hover:text-white transition-colors">
              +91 99999 99999
            </a>
          </div>
          <div>
            <p class="font-sans text-xs text-surface-600 uppercase tracking-wider mb-1">Based In</p>
            <p class="font-sans text-sm text-surface-400">India · Operating Pan-India & Abroad</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-surface-900">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 py-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="font-sans text-xs text-surface-700">
        &copy; {new Date().getFullYear()} EventConnect+. All rights reserved.
      </p>
      <div class="flex items-center gap-1 text-surface-700">
        <span class="text-xs font-sans">India's First Dedicated Guest Management Company</span>
        <span class="mx-2 text-surface-800">·</span>
        <a href="/contact" class="text-xs font-sans text-surface-600 hover:text-brand-400 transition-colors">Privacy Policy</a>
      </div>
    </div>
  </div>
</footer>
