---
const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/services', label: 'Services' },
  { href: '/how-it-works', label: 'How It Works' },
  { href: '/case-studies', label: 'Case Studies' },
];

const currentPath = Astro.url.pathname;
---

<header
  id="navbar"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-500 border-b border-transparent"
  style="background: rgba(15, 9, 26, 0.4); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);"
>
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <nav class="flex items-center justify-between h-20">

      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 group" aria-label="EventConnect+ Home">
        <img src="/logo-mark.svg" alt="" class="h-9 w-auto flex-shrink-0" />
        <div class="flex flex-col leading-none">
          <span class="font-display text-lg font-semibold text-white tracking-wide">EventConnect<span class="text-gradient">+</span></span>
          <span class="text-[9px] font-sans font-medium uppercase tracking-[0.18em] text-surface-600 mt-0.5">Guest Experience</span>
        </div>
      </a>

      <!-- Desktop Nav -->
      <ul class="hidden lg:flex items-center gap-8">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class={`font-sans text-sm font-medium transition-colors duration-200 relative group ${
                currentPath === link.href
                  ? 'text-brand-400'
                  : 'text-surface-400 hover:text-white'
              }`}
            >
              {link.label}
              <span class={`absolute -bottom-1 left-0 h-px bg-brand-gradient transition-all duration-300 ${
                currentPath === link.href ? 'w-full' : 'w-0 group-hover:w-full'
              }`}></span>
            </a>
          </li>
        ))}
      </ul>

      <!-- CTA + Mobile toggle -->
      <div class="flex items-center gap-4">
        <a
          href="/contact"
          class="hidden lg:inline-flex items-center gap-2 px-5 py-2.5 bg-brand-gradient rounded-lg text-white text-sm font-sans font-semibold shadow-lg shadow-brand-700/30 hover:shadow-brand-500/40 transition-all duration-300 hover:scale-105"
        >
          Start Planning
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
            <path d="M1 7h12M8 3l5 4-5 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>

        <!-- Mobile hamburger -->
        <button
          id="mobile-menu-btn"
          class="lg:hidden p-2 text-surface-400 hover:text-white transition-colors"
          aria-label="Toggle menu"
          aria-expanded="false"
        >
          <svg id="icon-open" width="22" height="22" viewBox="0 0 22 22" fill="none">
            <path d="M3 6h16M3 11h16M3 16h16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          <svg id="icon-close" width="22" height="22" viewBox="0 0 22 22" fill="none" class="hidden">
            <path d="M5 5l12 12M17 5L5 17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </button>
      </div>
    </nav>
  </div>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="hidden lg:hidden border-t border-surface-900 bg-surface-950/98 backdrop-blur-xl"
  >
    <div class="max-w-7xl mx-auto px-6 py-6 flex flex-col gap-4">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class={`font-sans text-sm font-medium py-2 border-b border-surface-900 transition-colors ${
            currentPath === link.href ? 'text-brand-400' : 'text-surface-300 hover:text-white'
          }`}
        >
          {link.label}
        </a>
      ))}
      <a
        href="/contact"
        class="mt-2 inline-flex items-center justify-center gap-2 px-5 py-3 bg-brand-gradient rounded-lg text-white text-sm font-sans font-semibold"
      >
        Start Planning
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  btn?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
    btn.setAttribute('aria-expanded', (!isOpen).toString());
  });

  // Close menu on nav link click
  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      menu.classList.add('hidden');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    });
  });
</script>
