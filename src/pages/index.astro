---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Guest Experience, Engineered"
  description="EventConnect+ designs and manages the complete guest journey for destination weddings, corporate events, and large-scale gatherings. India's First Dedicated Guest Management Company."
>

  <!-- ═══════════════════════════════════════════ HERO ══ -->
  <section class="relative min-h-screen flex items-center overflow-hidden bg-surface-950 pt-20">

    <!-- Gradient orbs -->
    <div class="absolute inset-0 pointer-events-none">
      <div class="absolute top-[-10%] left-[-5%] w-[600px] h-[600px] rounded-full bg-brand-700 opacity-20 blur-[120px] animate-float-slow"></div>
      <div class="absolute top-[20%] right-[-10%] w-[500px] h-[500px] rounded-full bg-brand-500 opacity-15 blur-[100px] animate-float-med"></div>
      <div class="absolute bottom-[-5%] left-[30%] w-[400px] h-[400px] rounded-full bg-brand-800 opacity-20 blur-[90px] animate-float-fast"></div>
    </div>

    <!-- Subtle grid -->
    <div class="absolute inset-0 pointer-events-none opacity-[0.03]"
      style="background-image: linear-gradient(rgba(155,0,255,1) 1px, transparent 1px), linear-gradient(90deg, rgba(155,0,255,1) 1px, transparent 1px); background-size: 80px 80px;">
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-8 py-24 lg:py-32">
      <div class="max-w-4xl">

        <!-- Authority badge -->
        <div class="inline-flex items-center gap-2.5 mb-8 px-4 py-2 rounded-full border border-gold-500/30 bg-gold-500/5 fade-in-section">
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><polygon points="6,1 7.5,4.5 11,5 8.5,7.5 9.2,11 6,9.2 2.8,11 3.5,7.5 1,5 4.5,4.5" fill="#d4a017"/></svg>
          <span class="font-sans text-xs font-semibold uppercase tracking-[0.2em] text-gold-500">India's First Dedicated Guest Management Company</span>
        </div>

        <!-- Headline -->
        <h1 class="font-display text-5xl sm:text-6xl lg:text-7xl xl:text-8xl font-medium text-white leading-[1.05] tracking-tight mb-8 fade-in-section fade-in-delay-1">
          Guest Experience,<br/>
          <span class="text-gradient">Engineered.</span>
        </h1>

        <!-- Subheadline -->
        <p class="font-sans text-lg lg:text-xl text-surface-400 leading-relaxed max-w-2xl mb-12 fade-in-section fade-in-delay-2">
          EventConnect+ designs and manages the complete guest journey — from first RSVP to final departure, ensuring every interaction, movement, and moment is structured, controlled, and seamless.
        </p>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4 fade-in-section fade-in-delay-3">
          <a
            href="/contact"
            class="inline-flex items-center gap-2.5 px-7 py-4 bg-brand-gradient rounded-xl text-white font-sans font-semibold text-sm shadow-xl shadow-brand-700/30 hover:shadow-brand-500/50 hover:scale-105 transition-all duration-300"
          >
            Plan Your Event
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M1 8h14M9 3l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <a
            href="/services"
            class="inline-flex items-center gap-2.5 px-7 py-4 rounded-xl border border-surface-700 text-surface-300 font-sans font-semibold text-sm hover:border-brand-700/50 hover:text-white transition-all duration-300"
          >
            Explore Services
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M1 8h14M9 3l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 opacity-40">
      <span class="font-sans text-xs uppercase tracking-widest text-surface-600">Scroll</span>
      <div class="w-px h-10 bg-gradient-to-b from-surface-600 to-transparent"></div>
    </div>
  </section>

  <!-- ══════════════════════════════════ CREDIBILITY STRIP ══ -->
  <section class="bg-surface-900 border-y border-surface-800">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 py-12">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-4 divide-y-2 divide-transparent">

        {[
          { stat: '10,000+', label: 'Guests Managed' },
          { stat: '30+',     label: 'Events Delivered' },
          { stat: '10+',     label: 'Destinations' },
          { stat: '★ Trusted', label: 'by leading event companies' },
        ].map((item, i) => (
          <div class={`flex flex-col items-center text-center px-6 ${i < 3 ? 'lg:border-r lg:border-surface-800' : ''} fade-in-section`} style={`transition-delay:${i*0.1}s`}>
            <span class="font-display text-3xl lg:text-4xl font-semibold text-gradient mb-1">{item.stat}</span>
            <span class="font-sans text-sm text-surface-500">{item.label}</span>
          </div>
        ))}

      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════ POSITIONING ══ -->
  <section class="section-padding bg-surface-950">
    <div class="container-inner">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-center">

        <!-- Left -->
        <div class="fade-in-section">
          <p class="label-text mb-4">Our Role</p>
          <h2 class="font-display text-4xl lg:text-5xl font-medium text-white leading-tight mb-6">
            We Design How<br/>Events Are Experienced
          </h2>
          <div class="w-12 h-0.5 bg-brand-gradient mb-6"></div>
          <p class="font-sans text-surface-400 leading-relaxed">
            While event planners focus on aesthetics, EventConnect+ builds the operational systems that make events seamless.
          </p>
        </div>

        <!-- Right -->
        <div class="fade-in-section fade-in-delay-2 space-y-6">
          <p class="font-sans text-surface-300 text-lg leading-relaxed">
            We manage guest communication, hospitality, logistics, and real-time coordination — ensuring guests never experience confusion or delay.
          </p>
          <p class="font-sans text-surface-500 leading-relaxed">
            From the moment an invitation is sent to the final departure transfer, every touchpoint is mapped, planned, and executed under a single accountable team.
          </p>

          <!-- Distinction cards -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4">
            {[
              { label: 'Not a planner', sub: 'We are the operational layer' },
              { label: 'Not decor', sub: 'We are the guest journey system' },
            ].map(item => (
              <div class="card-glass rounded-xl p-5 transition-all duration-300">
                <p class="font-sans text-xs uppercase tracking-widest text-surface-600 mb-1">{item.label}</p>
                <p class="font-sans text-sm text-surface-300">{item.sub}</p>
              </div>
            ))}
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ════════════════════════════ SERVICES PREVIEW ══ -->
  <section class="section-padding bg-surface-900/50">
    <div class="container-inner">

      <div class="text-center mb-16 fade-in-section">
        <p class="label-text mb-4">What We Manage</p>
        <h2 class="font-display text-4xl lg:text-5xl font-medium text-white">End-to-End Guest Operations</h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {[
          {
            icon: `<path d="M20 4H4a2 2 0 00-2 2v12a2 2 0 002 2h16a2 2 0 002-2V6a2 2 0 00-2-2zm0 4l-8 5-8-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>`,
            title: 'Guest Communication Systems',
            desc: 'Structured pre-event and on-ground communication workflows ensuring every guest is always informed.',
            viewBox: '0 0 24 24',
          },
          {
            icon: `<path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/><path d="M9 22V12h6v10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>`,
            title: 'Hospitality Management',
            desc: 'Hotel allocations, room upgrades, amenity coordination, and end-to-end accommodation oversight.',
            viewBox: '0 0 24 24',
          },
          {
            icon: `<circle cx="5" cy="18" r="3" stroke="currentColor" stroke-width="1.5" fill="none"/><circle cx="19" cy="18" r="3" stroke="currentColor" stroke-width="1.5" fill="none"/><path d="M1 3h15l4 9H1V3z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>`,
            title: 'Logistics & Transport',
            desc: 'Fleet coordination, transfer scheduling, route planning, and real-time movement management.',
            viewBox: '0 0 24 24',
          },
          {
            icon: `<path d="M22 16.92v3a2 2 0 01-2.18 2A19.8 19.8 0 012 4.18 2 2 0 014 2h3a2 2 0 012 1.72c.13.96.39 1.9.78 2.81a2 2 0 01-.45 2.11L8.09 9.9A16 16 0 0014.1 15.9l1.27-1.27a2 2 0 012.11-.45c.91.39 1.85.65 2.81.78A2 2 0 0122 16.92z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>`,
            title: 'On-Ground Operations',
            desc: 'Dedicated guest managers, real-time coordination, and precision execution across every venue zone.',
            viewBox: '0 0 24 24',
          },
          {
            icon: `<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>`,
            title: 'Destination Management',
            desc: 'Full destination setup — venue navigation, local vendor integration, and cultural experience curation.',
            viewBox: '0 0 24 24',
          },
          {
            icon: `<path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>`,
            title: 'Airport Operations',
            desc: 'Arrival and departure coordination, meet & greet protocols, and first/last-mile transfer management.',
            viewBox: '0 0 24 24',
          },
        ].map((service, i) => (
          <div class={`card-glass rounded-2xl p-7 group hover:scale-[1.02] transition-all duration-300 fade-in-section`} style={`transition-delay:${(i%3)*0.1}s`}>
            <div class="w-11 h-11 rounded-xl bg-brand-700/20 border border-brand-700/30 flex items-center justify-center mb-5 group-hover:bg-brand-700/30 transition-colors duration-300">
              <svg width="20" height="20" viewBox={service.viewBox} fill="none" class="text-brand-400">
                <Fragment set:html={service.icon} />
              </svg>
            </div>
            <h3 class="font-display text-xl font-medium text-white mb-3">{service.title}</h3>
            <p class="font-sans text-sm text-surface-500 leading-relaxed">{service.desc}</p>
          </div>
        ))}
      </div>

      <div class="text-center mt-12 fade-in-section">
        <a href="/services" class="inline-flex items-center gap-2 font-sans text-sm font-medium text-brand-400 hover:text-brand-300 transition-colors">
          View all services
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M1 7h12M8 3l5 4-5 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>

    </div>
  </section>

  <!-- ═════════════════════════ GUEST JOURNEY ══ -->
  <section class="section-padding bg-surface-950 relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[400px] rounded-full bg-brand-700 opacity-5 blur-[120px]"></div>
    </div>

    <div class="container-inner relative z-10">

      <div class="text-center mb-16 fade-in-section">
        <p class="label-text mb-4">The Journey</p>
        <h2 class="font-display text-4xl lg:text-5xl font-medium text-white mb-4">The Guest Experience Journey</h2>
        <p class="font-sans text-surface-500 max-w-xl mx-auto">Every stage mapped, managed, and executed with precision.</p>
      </div>

      <!-- Journey flow -->
      <div class="flex flex-wrap justify-center items-center gap-0 mb-16 fade-in-section">
        {['Invitation', 'RSVP', 'Travel', 'Arrival', 'Stay', 'Event', 'Departure'].map((step, i, arr) => (
          <>
            <div class="flex flex-col items-center">
              <div class="w-10 h-10 rounded-full bg-brand-gradient flex items-center justify-center text-white font-sans text-xs font-bold shadow-lg shadow-brand-700/40 mb-2">
                {i + 1}
              </div>
              <span class="font-sans text-xs font-medium text-surface-400 whitespace-nowrap px-2">{step}</span>
            </div>
            {i < arr.length - 1 && (
              <div class="w-8 sm:w-12 h-px bg-gradient-to-r from-brand-700 to-brand-500 mb-4 flex-shrink-0"></div>
            )}
          </>
        ))}
      </div>

      <!-- Two-column content -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">

        <div class="fade-in-section">
          <h3 class="font-display text-2xl font-medium text-white mb-6">Our approach ensures:</h3>
          <ul class="space-y-4">
            {[
              'Clear communication at every stage',
              'Planned guest movement and transfers',
              'Calm, controlled on-ground operations',
              'Single-point accountability',
              'Seamless guest journeys — start to finish',
            ].map(item => (
              <li class="flex items-start gap-3">
                <div class="w-5 h-5 rounded-full bg-brand-700/30 border border-brand-700/50 flex items-center justify-center flex-shrink-0 mt-0.5">
                  <svg width="10" height="10" viewBox="0 0 10 10" fill="none"><path d="M2 5l2 2 4-4" stroke="#9B00FF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </div>
                <span class="font-sans text-surface-300 text-sm">{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="fade-in-section fade-in-delay-2">
          <div class="card-glass rounded-2xl p-8">
            <p class="font-sans text-xs uppercase tracking-widest text-surface-600 mb-4">The Result</p>
            <p class="font-display text-3xl text-white font-medium leading-snug mb-6">
              Smooth events.<br/>Confident hosts.<br/>Happy guests.
            </p>
            <div class="w-10 h-0.5 bg-brand-gradient mb-6"></div>
            <p class="font-sans text-sm text-surface-500 leading-relaxed">
              EventConnect+ manages every stage of this journey — so you never have to worry about what's happening behind the scenes.
            </p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════ WHY ══ -->
  <section class="section-padding bg-surface-900/40">
    <div class="container-inner">

      <div class="text-center mb-16 fade-in-section">
        <p class="label-text mb-4">Why EventConnect+</p>
        <h2 class="font-display text-4xl lg:text-5xl font-medium text-white">Built for Events Where<br/>Precision Matters</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-14">
        {[
          {
            title: 'System-Driven Execution',
            desc: 'We don\'t rely on improvisation. Every event runs on a structured guest management system built specifically for your event scale and requirements.',
            icon: '⬡',
          },
          {
            title: 'Single-Point Accountability',
            desc: 'One team. One command centre. Full ownership of every guest interaction — from the first communication to the final departure.',
            icon: '◎',
          },
          {
            title: 'Integrated Operations',
            desc: 'Hospitality, logistics, communication, and on-ground management seamlessly integrated into a unified guest experience layer.',
            icon: '⊞',
          },
        ].map((item, i) => (
          <div class={`card-glass rounded-2xl p-8 group hover:border-brand-700/40 transition-all duration-300 fade-in-section`} style={`transition-delay:${i*0.15}s`}>
            <div class="text-2xl text-brand-500 mb-5">{item.icon}</div>
            <h3 class="font-display text-xl font-medium text-white mb-3">{item.title}</h3>
            <p class="font-sans text-sm text-surface-500 leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>

      <!-- Authority badge strip -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 fade-in-section">
        <div class="inline-flex items-center gap-3 px-6 py-3 rounded-full border border-gold-500/25 bg-gold-500/5">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><polygon points="7,1.5 8.8,5 12.5,5.5 9.8,8 10.5,12 7,10.1 3.5,12 4.2,8 1.5,5.5 5.2,5" fill="#d4a017"/></svg>
          <span class="font-sans text-xs font-semibold uppercase tracking-[0.18em] text-gold-500">India's No. 1 Guest Experience Company</span>
        </div>
        <div class="hidden sm:block w-px h-6 bg-surface-800"></div>
        <div class="inline-flex items-center gap-3 px-6 py-3 rounded-full border border-brand-700/25 bg-brand-700/5">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><circle cx="7" cy="7" r="5.5" stroke="#9B00FF" stroke-width="1.5"/><path d="M4.5 7l2 2 3-3" stroke="#9B00FF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span class="font-sans text-xs font-semibold uppercase tracking-[0.18em] text-brand-400">Trusted by India's Top Event Companies</span>
        </div>
      </div>

    </div>
  </section>

  <!-- ═════════════════════════════ FINAL CTA ══ -->
  <section class="section-padding bg-surface-950 relative overflow-hidden">
    <div class="absolute inset-0 bg-brand-gradient opacity-[0.06] pointer-events-none"></div>
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-px h-24 bg-gradient-to-b from-transparent to-brand-700/40"></div>

    <div class="container-inner relative z-10 text-center">
      <div class="max-w-3xl mx-auto fade-in-section">
        <p class="label-text mb-6">Let's Begin</p>
        <h2 class="font-display text-4xl lg:text-6xl font-medium text-white mb-6 leading-tight">
          Let's Build the System<br/>Behind Your Event
        </h2>
        <p class="font-sans text-surface-400 text-lg mb-10 leading-relaxed">
          Whether it's a destination wedding for 500 or a corporate summit across multiple cities — EventConnect+ engineers the guest experience from end to end.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href="/contact"
            class="inline-flex items-center gap-2.5 px-8 py-4 bg-brand-gradient rounded-xl text-white font-sans font-semibold shadow-xl shadow-brand-700/30 hover:shadow-brand-500/50 hover:scale-105 transition-all duration-300"
          >
            Start Planning Your Event
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M1 8h14M9 3l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <a
            href="/how-it-works"
            class="inline-flex items-center gap-2 font-sans text-sm font-medium text-surface-400 hover:text-white transition-colors"
          >
            See how it works
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M1 7h12M8 3l5 4-5 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

</Layout>
