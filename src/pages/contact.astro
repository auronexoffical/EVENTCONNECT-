---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact"
  description="Start planning your event with EventConnect+. Tell us about your event and we'll design a guest experience system tailored to your needs."
>

  <!-- ═══════════ HERO ══ -->
  <section class="relative pt-40 pb-12 overflow-hidden bg-surface-950">
    <div class="absolute inset-0 pointer-events-none">
      <div class="absolute top-0 right-[10%] w-[450px] h-[400px] rounded-full bg-brand-700 opacity-15 blur-[110px] animate-float-slow"></div>
      <div class="absolute bottom-0 left-[5%] w-[350px] h-[300px] rounded-full bg-brand-500 opacity-10 blur-[80px] animate-float-med"></div>
    </div>
    <div class="container-inner relative z-10 text-center">
      <p class="label-text mb-5 fade-in-section">Get In Touch</p>
      <h1 class="font-display text-5xl sm:text-6xl lg:text-7xl font-medium text-white leading-[1.05] tracking-tight mb-6 fade-in-section fade-in-delay-1">
        Start Planning<br/><span class="text-gradient">Your Event</span>
      </h1>
      <p class="font-sans text-lg text-surface-400 max-w-xl mx-auto leading-relaxed fade-in-section fade-in-delay-2">
        Tell us about your event and we'll reach out to discuss how EventConnect+ can engineer your guest experience.
      </p>
    </div>
  </section>

  <!-- ═══════════ CONTACT GRID ══ -->
  <section class="section-padding bg-surface-950">
    <div class="container-inner">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">

        <!-- Left: info + trust -->
        <div class="lg:col-span-4 space-y-8 fade-in-section">

          <!-- Who we work with -->
          <div>
            <p class="label-text mb-4">We work with</p>
            <ul class="space-y-3">
              {[
                'Destination wedding planners & hosts',
                'Corporate event teams & HR departments',
                'HNI & NRI families planning events',
                'Large-scale event organizers',
                'Luxury event agencies',
              ].map(item => (
                <li class="flex items-start gap-3">
                  <div class="w-5 h-5 rounded-full bg-brand-700/20 border border-brand-700/40 flex items-center justify-center flex-shrink-0 mt-0.5">
                    <svg width="10" height="10" viewBox="0 0 10 10" fill="none"><path d="M2 5l2 2 4-4" stroke="#9B00FF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </div>
                  <span class="font-sans text-sm text-surface-400">{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Divider -->
          <div class="w-full h-px bg-surface-800"></div>

          <!-- Contact details -->
          <div class="space-y-5">
            <div>
              <p class="font-sans text-xs uppercase tracking-widest text-surface-700 mb-1.5">Email</p>
              <a href="mailto:hello@eventconnectplus.com" class="font-sans text-sm text-surface-300 hover:text-white transition-colors">
                hello@eventconnectplus.com
              </a>
            </div>
            <div>
              <p class="font-sans text-xs uppercase tracking-widest text-surface-700 mb-1.5">Phone</p>
              <a href="tel:+919999999999" class="font-sans text-sm text-surface-300 hover:text-white transition-colors">
                +91 99999 99999
              </a>
            </div>
            <div>
              <p class="font-sans text-xs uppercase tracking-widest text-surface-700 mb-1.5">Operating Region</p>
              <p class="font-sans text-sm text-surface-400">Pan-India & International</p>
            </div>
          </div>

          <!-- Divider -->
          <div class="w-full h-px bg-surface-800"></div>

          <!-- Trust badge -->
          <div class="flex items-center gap-3 p-4 rounded-xl border border-gold-500/20 bg-gold-500/5">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><polygon points="9,2 11,7 16.5,7.5 12.5,11 13.8,16.5 9,13.8 4.2,16.5 5.5,11 1.5,7.5 7,7" fill="#d4a017"/></svg>
            <p class="font-sans text-xs text-gold-500 font-medium">India's First Dedicated Guest Management Company</p>
          </div>

        </div>

        <!-- Right: form -->
        <div class="lg:col-span-8 fade-in-section fade-in-delay-2">
          <div class="card-glass rounded-2xl p-8 lg:p-10">

            <p class="font-sans text-xs uppercase tracking-widest text-surface-700 mb-8">Event Enquiry Form</p>

            <form
              class="space-y-6"
              id="contact-form"
              novalidate
            >
              <!-- Name + Company -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                  <label for="name" class="block font-sans text-xs uppercase tracking-widest text-surface-600 mb-2">Full Name *</label>
                  <input
                    id="name"
                    name="name"
                    type="text"
                    required
                    placeholder="Your full name"
                    class="w-full bg-surface-900 border border-surface-800 rounded-xl px-4 py-3.5 font-sans text-sm text-white placeholder-surface-700 focus:outline-none focus:border-brand-700/60 focus:bg-surface-900 transition-colors duration-200"
                  />
                </div>
                <div>
                  <label for="email" class="block font-sans text-xs uppercase tracking-widest text-surface-600 mb-2">Email Address *</label>
                  <input
                    id="email"
                    name="email"
                    type="email"
                    required
                    placeholder="you@company.com"
                    class="w-full bg-surface-900 border border-surface-800 rounded-xl px-4 py-3.5 font-sans text-sm text-white placeholder-surface-700 focus:outline-none focus:border-brand-700/60 transition-colors duration-200"
                  />
                </div>
              </div>

              <!-- Phone + Event Type -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                  <label for="phone" class="block font-sans text-xs uppercase tracking-widest text-surface-600 mb-2">Phone Number</label>
                  <input
                    id="phone"
                    name="phone"
                    type="tel"
                    placeholder="+91 00000 00000"
                    class="w-full bg-surface-900 border border-surface-800 rounded-xl px-4 py-3.5 font-sans text-sm text-white placeholder-surface-700 focus:outline-none focus:border-brand-700/60 transition-colors duration-200"
                  />
                </div>
                <div>
                  <label for="event_type" class="block font-sans text-xs uppercase tracking-widest text-surface-600 mb-2">Event Type *</label>
                  <select
                    id="event_type"
                    name="event_type"
                    required
                    class="w-full bg-surface-900 border border-surface-800 rounded-xl px-4 py-3.5 font-sans text-sm text-white focus:outline-none focus:border-brand-700/60 transition-colors duration-200 appearance-none cursor-pointer"
                  >
                    <option value="" disabled selected class="text-surface-700">Select event type</option>
                    <option value="destination_wedding">Destination Wedding</option>
                    <option value="corporate_event">Corporate Event</option>
                    <option value="social_gathering">Large Social Gathering</option>
                    <option value="incentive_trip">Corporate Incentive Trip</option>
                    <option value="other">Other</option>
                  </select>
                </div>
              </div>

              <!-- Guest count + Date -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                  <label for="guest_count" class="block font-sans text-xs uppercase tracking-widest text-surface-600 mb-2">Expected Guest Count</label>
                  <select
                    id="guest_count"
                    name="guest_count"
                    class="w-full bg-surface-900 border border-surface-800 rounded-xl px-4 py-3.5 font-sans text-sm text-white focus:outline-none focus:border-brand-700/60 transition-colors duration-200 appearance-none cursor-pointer"
                  >
                    <option value="" disabled selected class="text-surface-700">Select range</option>
                    <option value="under_100">Under 100 guests</option>
                    <option value="100_250">100 – 250 guests</option>
                    <option value="250_500">250 – 500 guests</option>
                    <option value="over_500">500+ guests</option>
                  </select>
                </div>
                <div>
                  <label for="event_date" class="block font-sans text-xs uppercase tracking-widest text-surface-600 mb-2">Approximate Event Date</label>
                  <input
                    id="event_date"
                    name="event_date"
                    type="text"
                    placeholder="Month & Year (e.g. Dec 2025)"
                    class="w-full bg-surface-900 border border-surface-800 rounded-xl px-4 py-3.5 font-sans text-sm text-white placeholder-surface-700 focus:outline-none focus:border-brand-700/60 transition-colors duration-200"
                  />
                </div>
              </div>

              <!-- Location -->
              <div>
                <label for="location" class="block font-sans text-xs uppercase tracking-widest text-surface-600 mb-2">Event Location / Destination</label>
                <input
                  id="location"
                  name="location"
                  type="text"
                  placeholder="City, state, or destination"
                  class="w-full bg-surface-900 border border-surface-800 rounded-xl px-4 py-3.5 font-sans text-sm text-white placeholder-surface-700 focus:outline-none focus:border-brand-700/60 transition-colors duration-200"
                />
              </div>

              <!-- Message -->
              <div>
                <label for="message" class="block font-sans text-xs uppercase tracking-widest text-surface-600 mb-2">Tell Us About Your Event</label>
                <textarea
                  id="message"
                  name="message"
                  rows="4"
                  placeholder="Brief overview of your event, key requirements, or any questions..."
                  class="w-full bg-surface-900 border border-surface-800 rounded-xl px-4 py-3.5 font-sans text-sm text-white placeholder-surface-700 focus:outline-none focus:border-brand-700/60 transition-colors duration-200 resize-none"
                ></textarea>
              </div>

              <!-- Submit -->
              <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4 pt-2">
                <button
                  type="submit"
                  id="submit-btn"
                  class="inline-flex items-center gap-2.5 px-8 py-4 bg-brand-gradient rounded-xl text-white font-sans font-semibold shadow-xl shadow-brand-700/30 hover:shadow-brand-500/50 hover:scale-105 active:scale-100 transition-all duration-300 cursor-pointer"
                >
                  <span id="btn-text">Send Enquiry</span>
                  <svg id="btn-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M1 8h14M9 3l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
                <p class="font-sans text-xs text-surface-700">We typically respond within 24 hours.</p>
              </div>

              <!-- Success / error messages -->
              <div id="form-success" class="hidden p-4 rounded-xl bg-brand-700/15 border border-brand-700/30">
                <p class="font-sans text-sm text-brand-300">
                  Thank you! Your enquiry has been received. We'll reach out within 24 hours.
                </p>
              </div>
              <div id="form-error" class="hidden p-4 rounded-xl bg-red-900/20 border border-red-700/30">
                <p class="font-sans text-sm text-red-400">
                  Something went wrong. Please email us directly at hello@eventconnectplus.com.
                </p>
              </div>

            </form>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ══════════ BOTTOM STRIP ══ -->
  <section class="bg-surface-900/30 border-t border-surface-800 py-14">
    <div class="container-inner text-center">
      <p class="font-sans text-sm text-surface-600 mb-2">Prefer a direct conversation?</p>
      <a href="tel:+919999999999" class="font-display text-2xl lg:text-3xl text-white hover:text-brand-400 transition-colors">+91 99999 99999</a>
    </div>
  </section>

</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const successMsg = document.getElementById('form-success');
  const errorMsg = document.getElementById('form-error');
  const btnText = document.getElementById('btn-text');
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    // Show loading state
    if (btnText) btnText.textContent = 'Sending…';
    if (submitBtn) submitBtn.disabled = true;

    // Simulate submission (replace with real API call)
    await new Promise(r => setTimeout(r, 1200));

    if (btnText) btnText.textContent = 'Sent!';
    successMsg?.classList.remove('hidden');
    errorMsg?.classList.add('hidden');
    form.reset();

    setTimeout(() => {
      if (btnText) btnText.textContent = 'Send Enquiry';
      if (submitBtn) submitBtn.disabled = false;
    }, 3000);
  });
</script>
